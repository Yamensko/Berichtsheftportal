@page "/report-editor/{Year:int}/{Week:int}"
@attribute [Authorize]
@using Berichtsportal.Models
@using Berichtsportal.Services
@rendermode InteractiveServer
@inject ReportService ReportService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserServices UserService
@inject NavigationManager NavManager
@implements IDisposable

<div class="dashboard-wrapper">

    <h1 class="overview-title">Wochenbericht</h1>

    @* KW-Navigation und Zurueck-Button *@
    <div class="top-bar">
        <div class="header-nav">
            <button class="btn-nav" @onclick="GoToPrevWeek">◀</button>
            <span class="period-label">KW @Week / @Year</span>
            <button class="btn-nav" @onclick="GoToNextWeek">▶</button>
        </div>

        <button class="btn-nav btn-pill" @onclick="Cancel">
            Zur Übersicht
        </button>
    </div>

    @* Anzeige des Datumszeitraums (Mo-Fr) fuer die aktuelle KW *@
    <span class="date-range">
        Arbeitswoche (Mo. - Fr.): @CurrentWeekRange
    </span>

    @* Ladezustand: Bericht wird noch aus der DB geholt *@
    @if (currentReport == null)
    {
        <div class="editor-container">
            <p>Lade Bericht...</p>
        </div>
    }
    else
    {
        <br />
        @* Bei eingereichten/genehmigten Berichten: Entsperr-Button anzeigen *@
        @if (IsLocked)
        {
            <button class="btn-primary" @onclick="EnableEditing">
                Bearbeiten
            </button>
        }

        <div class="editor-container">

            @* Speicherstatus-Anzeige und manueller Speicher-Button *@
            <div class="save-status">
                @saveStatus
                <button class="btn-pill z-speichern" @onclick="ManuallySave">
                    💾 Zwischenspeichern
                </button>
            </div>

            @* @key erzwingt Neuinitialisierung des Editors bei Wochenwechsel,
               damit Quill.js den neuen Inhalt korrekt laedt *@
            <div @key="@($"editor-wrapper-{Year}-{Week}")">
                @* Quill.js Rich-Text-Editor ueber Blazox-Komponente *@
                <RichTextEditor @ref="editor"
                                ReadOnly="@IsLocked"
                                Theme="snow"
                                Placeholder="Was hast du diese Woche gemacht?"
                                OnTextContentChange="HandleEditorChange">

                    @* Quill-Toolbar: Ueberschriften, Formatierung, Farben, Listen, Links, Groesse *@
                    <ToolbarContent>
                        <select class="ql-header">
                            <option value="1"></option>
                            <option value="2"></option>
                            <option value="3"></option>
                            <option value="4"></option>
                            <option value="5"></option>
                            <option selected></option>
                        </select>

                        <span class="ql-formats">
                            <button class="ql-bold"></button>
                            <button class="ql-italic"></button>
                            <button class="ql-underline"></button>
                            <button class="ql-strike"></button>
                        </span>

                        <span class="ql-formats">
                            <select class="ql-color"></select>
                            <select class="ql-background"></select>
                        </span>

                        <span>
                            <button class="ql-list" value="ordered"></button>
                            <button class="ql-list" value="bullet"></button>
                        </span>

                        <span class="ql-formats">
                            <button class="ql-link"></button>
                        </span>

                        <select class="ql-size">
                            <option value="small"></option>
                            <option selected></option>
                            <option value="large"></option>
                            <option value="huge"></option>
                        </select>
                    </ToolbarContent>
                </RichTextEditor>
            </div>

            @* Fehlermeldung anzeigen falls Speichern oder Freigabe fehlgeschlagen *@
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }

            @* Status-Hinweise: Warnung bei Ablehnung, Bestaetigung bei Genehmigung *@
            @if (currentReport.Status == ReportStatus.Rejected)
            {
                <div class="alert alert-warning">
                    ⚠️ Dieser Bericht wurde zurückgewiesen. Bitte überarbeiten.
                </div>
            }
            @if (currentReport.Status == ReportStatus.Approved)
            {
                <div class="alert alert-success">
                    ✅ Bericht wurde vom Ausbilder akzeptiert
                </div>
            }

            @* Kommentar-Bereich: Feedback des Ausbilders zum Bericht *@
            <div class="comment-section">
                <h4>Feedback vom Ausbilder:</h4>
                @if (currentReport.Comments != null && currentReport.Comments.Any())
                {
                    @foreach (var c in currentReport.Comments)
                    {
                        <div class="comment-box">
                            <b>@c.CreatedAt?.ToString("dd.MM.yyyy")</b><br />
                            @c.CommentText
                        </div>
                    }
                }
                else
                {
                    <p>Kein Feedback vorhanden</p>
                }
            </div>

            @* Freigabe-Button nur bei Draft oder Rejected (nicht bei Submitted/Approved) *@
            @if (currentReport.Status == ReportStatus.Draft || currentReport.Status == ReportStatus.Rejected)
            {
                <div class="action-bar">
                    <button class="btn-submit" @onclick="Freigeben">
                        Freigeben
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    // URL-Parameter: /report-editor/{Year}/{Week}
    [Parameter] public int Year { get; set; }
    [Parameter] public int Week { get; set; }

    private RichTextEditor? editor;              // Referenz auf den Quill.js Editor
    private System.Timers.Timer? saveTimer;      // Timer fuer Debounce/AutoSave
    private string saveStatus = "Bereit";        // Statustext (Bereit/Speichere/Gespeichert)
    private string? errorMessage;                // Fehlermeldung fuer den Benutzer
    private Report? currentReport;               // Aktuell geladener Bericht aus der DB
    private bool isEditing = false;              // True wenn gesperrter Bericht entsperrt wurde
    private bool isDisposed = false;             // Schutz vor Zugriffen nach Component-Zerstoerung
    private User? currentUser;

    /// Editor ist gesperrt wenn Status Submitted oder Approved UND nicht manuell entsperrt
    private bool IsLocked =>
        currentReport != null &&
        (currentReport.Status == ReportStatus.Submitted || currentReport.Status == ReportStatus.Approved) &&
        !isEditing;

    /// Berechnet den Anzeigetext "Mo-Fr" fuer die aktuelle Kalenderwoche
    private string CurrentWeekRange
    {
        get
        {
            DateTime start = GetFirstDayOfWeek(Year, Week);
            DateTime end = start.AddDays(4);
            return $"{start:dd.MM.yyyy} - {end:dd.MM.yyyy}";
        }
    }

    /// Wird bei jedem URL-Wechsel aufgerufen (auch bei KW-Navigation)
    /// Laedt Benutzer, prueft Berechtigung, holt Bericht aus DB (Lazy Creation)
    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        currentUser = await UserService.GetCurrentUserAsync(principal);

        if (currentUser == null)
            return;

        // Nur Azubis duerfen den Editor nutzen
        if (!string.Equals(
                currentUser.Role.RoleName,
                "Auszubildender",
                StringComparison.OrdinalIgnoreCase))
        {
            NavManager.NavigateTo("/access-denied");
            return;
        }

        // Bericht mit Kommentaren laden (fuer Ausbilder-Feedback)
        currentReport = await ReportService.GetReportWithCommentsByWeekAsync(currentUser.UserId, Year, Week);

        // Lazy Creation: Bericht existiert noch nicht -> neu anlegen
        if (currentReport == null)
        {
            currentReport = await ReportService.GetOrCreateReportAsync( currentUser.UserId, Year, Week);
        }

        // Falls Editor schon initialisiert: HTML-Inhalt laden
        if (editor != null && currentReport != null)
        {
            await editor.LoadHTMLContent(currentReport.Content ?? "");
        }

        saveStatus = "Gespeichert";
    }

    /// Nach dem ersten Render: kurz warten bis Quill.js per JS initialisiert ist,
    /// dann gespeicherten HTML-Inhalt in den Editor laden
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(300);
            if (currentReport != null && editor != null)
            {
                await editor.LoadHTMLContent(currentReport.Content ?? "");
                StateHasChanged();
            }
        }
    }

    /// Wird bei jeder Texteingabe im Editor ausgeloest
    /// Startet den Debounce-Timer neu (AutoSave nach 2 Sekunden Pause)
    private void HandleEditorChange(string text)
    {
        saveStatus = "Änderungen erkannt...";
        ResetTimer();
    }

    /// Debounce-Logik: Alten Timer stoppen und neuen starten
    /// Erst wenn 2 Sekunden lang keine Eingabe kommt, wird gespeichert
    private void ResetTimer()
    {
        // Alten Timer aufraumen (Null-Conditional: nur wenn Timer existiert)
        saveTimer?.Stop();
        saveTimer?.Dispose();

        // Neuen Timer erstellen: 2000ms Verzoegerung, einmaliger Ausloeser
        saveTimer = new System.Timers.Timer(2000);
        // Anonyme Funktion: Bei Elapsed-Event wird AutoSave aufgerufen
        saveTimer.Elapsed += async (_, _) => await AutoSave();
        saveTimer.AutoReset = false;  // Nur einmal ausloesen, nicht wiederholt
        saveTimer.Start();
    }

    /// Manuelles Speichern per Button-Klick (stoppt auch den AutoSave-Timer)
    private async Task ManuallySave()
    {
        if (editor == null)
        {
            return;
        }
        saveStatus = "Speichere...";
        await SaveData();
        saveStatus = "gespeichert ✅";
        saveTimer?.Stop();
        StateHasChanged();
    }

    /// AutoSave: Wird vom Timer aufgerufen (laeuft auf einem Hintergrund-Thread)
    /// InvokeAsync wechselt zurueck auf den Blazor-UI-Thread (SignalR-Kontext)
    private async Task AutoSave()
    {
        if (isDisposed || currentReport == null || editor == null)
            return;

        try
        {
            // InvokeAsync: Timer laeuft auf eigenem Thread, aber Blazor-UI
            // darf nur vom SignalR-Thread aus aktualisiert werden
            await InvokeAsync(async () =>
            {
                if (isDisposed)
                    return;

                await SaveData();
                saveStatus = "Automatisch gespeichert";
                StateHasChanged();
            });
        }
        catch
        {
            // Ignorieren wenn Component bereits zerstoert wurde
        }
    }

    /// Holt den HTML-Inhalt aus Quill.js und speichert ihn in der DB
    /// Nur wenn sich der Inhalt geaendert hat (Vergleich mit currentReport.Content)
    private async Task SaveData()
    {
        if (isDisposed || currentReport == null || editor == null)
            return;

        try
        {
            // HTML aus dem Quill.js Editor holen (via JS Interop)
            string html = await editor.GetHTML();

            // Nur speichern wenn sich der Inhalt tatsaechlich geaendert hat
            if (currentReport.Content != html)
            {
                currentReport.Content = html;
                await ReportService.SaveReportAsync(currentReport);
            }

            errorMessage = null;
        }
        catch
        {
            errorMessage = "Speichern fehlgeschlagen. Dein Text ist noch im Editor sichtbar — bitte kopiere ihn (Strg+A, Strg+C) und klicke danach auf 'Zwischenspeichern'.";
        }
    }

    // Bericht freigeben: Speichern, Status auf Submitted setzen, E-Mail an Ausbilder
    private async Task Freigeben()
    {
        if (currentReport == null || currentUser == null || IsLocked) return;

        await SaveData();
        isEditing = false;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            // SubmitReportAsync setzt Status und sendet Benachrichtigung per Graph API
            await ReportService.SubmitReportAsync(
                currentReport.ReportId, currentUser.UserId, authState.User);
        }
        catch (InvalidOperationException)
        {
            // Fallback: Status trotzdem auf Submitted setzen, aber Benutzer informieren
            currentReport.Status = ReportStatus.Submitted;
            await ReportService.SaveReportAsync(currentReport);
            errorMessage = "Bericht wurde freigegeben, aber die E-Mail-Benachrichtigung konnte nicht gesendet werden. Bitte informiere deinen Ausbilder manuell.";
            StateHasChanged();
            await Task.Delay(4000);
        }

        NavManager.NavigateTo("/reports");
    }

    // Gesperrten Bericht zum Bearbeiten entsperren (setzt Status zurueck auf Draft)
    private async Task EnableEditing()
    {
        if (currentReport == null) return;
        isEditing = true;
        currentReport.Status = ReportStatus.Draft;
        await ReportService.SaveReportAsync(currentReport);
        saveStatus = "Bearbeitung aktiv";
    }

    // IDisposable: Timer-Ressourcen freigeben wenn die Seite verlassen wird
    // isDisposed verhindert, dass AutoSave nach dem Verlassen noch läuft
    public void Dispose()
    {
        isDisposed = true;
        saveTimer?.Stop();
        saveTimer?.Dispose();
    }

    // --- KW-Navigation ---

    private void GoToPrevWeek() => Navigate(-7);
    private void GoToNextWeek() => Navigate(7);

    // Berechnet die neue KW basierend auf Tagen-Offset und navigiert dorthin
    private void Navigate(int days)
    {
        var date = GetFirstDayOfWeek(Year, Week).AddDays(days);
        var cal = CultureInfo.CurrentCulture.Calendar;
        int newWeek = cal.GetWeekOfYear(date, CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday);
        int newYear = date.Year;
        // Sonderfall: KW 52/53 im Januar gehoert noch zum Vorjahr
        if (newWeek > 50 && date.Month == 1) newYear--;
        NavManager.NavigateTo($"/report-editor/{newYear}/{newWeek}");
    }

    private void Cancel() => NavManager.NavigateTo("/reports");

    // Berechnet den Montag einer KW nach ISO 8601 (europaeische Kalenderregel)
    private DateTime GetFirstDayOfWeek(int year, int week)
    {
        DateTime jan1 = new(year, 1, 1);
        int daysOffset = DayOfWeek.Thursday - jan1.DayOfWeek;
        DateTime firstThursday = jan1.AddDays(daysOffset);
        var cal = CultureInfo.CurrentCulture.Calendar;
        int firstWeek = cal.GetWeekOfYear(firstThursday, CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday);
        if (firstWeek <= 1) week--;
        return firstThursday.AddDays(week * 7 - 3);
    }
}
